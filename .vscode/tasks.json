{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compilar C++ (SCons)",
            "type": "shell",
            "command": "scons",
            "args": [
                "platform=linux",
                "target=template_debug",
                "use_hot_reload=yes",
                "-j4"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}